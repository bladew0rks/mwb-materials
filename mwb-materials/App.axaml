<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mwb_materials.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="CardBrush" Color="#24272D" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33373F" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA1AB" />
    <SolidColorBrush x:Key="LogBrush" Color="#16181B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB8B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F07A7A" />
    <FontFamily x:Key="MonoFont">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Consolas, monospace</FontFamily>
  </Application.Resources>


  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Application.Styles>
</Application>
