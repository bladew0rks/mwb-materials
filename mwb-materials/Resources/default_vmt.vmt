"VertexLitGeneric"
{
    "$basetexture" "${ALBEDOPATH}"
    "$bumpmap" "${NORMALPATH}"
    "$phongexponenttexture" "${EXPONENTPATH}"

    /////////////////
    "$color2" "[0 0 0]"                                     //do not touch this
    "$blendtintbybasealpha" "${BLENDTINTBYBASEALPHA}"       //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "${ENVMAPFILE}"
    "$envmaptint" "${ENVMAPTINT}"                 

${OPACITYBLOCK}

${DETAILBLOCK}

    //remove this if not using MWB
    "Proxies"
    {
        "MwEnvMapTint"
        {
            "min" "0"
            "max" "1"
            "envmap" "${ENVMAPFILE}"
            "color" "${ENVMAPTINT}"
        }
    }
}
